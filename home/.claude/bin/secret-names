#!/bin/sh
# Names of the variables kept out of Claude's environment: everything defined in the
# untracked secrets files.
for f in "$HOME"/projects/shared/*.secrets.env; do
  [ -f "$f" ] || continue
  sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$f"
done
